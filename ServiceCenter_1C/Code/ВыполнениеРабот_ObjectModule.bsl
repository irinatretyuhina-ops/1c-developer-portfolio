Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не указана заявка.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Сообщить("Не указан сотрудник.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Работы.Количество() = 0 Тогда
		Сообщить("Не указано ни одной выполненной работы.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	
	
	Для Каждого СтрокаРаботы Из Работы Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРаботы.ВидРаботы) Тогда
			Сообщить("В одной из строк не указан вид работы.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если СтрокаРаботы.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше нуля.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если СтрокаРаботы.Цена < 0 Тогда
			Сообщить("Цена не может быть отрицательной.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	
	Движения.ВыполненныеРаботы.Записывать = Истина;
	
	Для Каждого СтрокаРаботы Из Работы Цикл
		
		Движение = Движения.ВыполненныеРаботы.Добавить();
		
		Движение.Период = Дата;
		Движение.Сотрудник = Сотрудник;
		Движение.Клиент = Заявка.Клиент;
		Движение.ВидРаботы = СтрокаРаботы.ВидРаботы;
		Движение.Количество = СтрокаРаботы.Количество;
		Движение.Сумма = СтрокаРаботы.Сумма;
		
	КонецЦикла;
	
	
	ОбъектЗаявки = Заявка.ПолучитьОбъект();
	ОбъектЗаявки.Статус = Перечисления.СтатусЗаявки.Выполнена;
	ОбъектЗаявки.Записать();
	
КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ЗначениеЗаполнено(Заявка) Тогда
		
		ОбъектЗаявки = Заявка.ПолучитьОбъект();
		
		Если ОбъектЗаявки.Статус = Перечисления.СтатусЗаявки.Выполнена Тогда
			ОбъектЗаявки.Статус = Перечисления.СтатусЗаявки.ВРаботе;
			ОбъектЗаявки.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры