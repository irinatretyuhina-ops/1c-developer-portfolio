Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		
		Сообщить("Не указан клиент.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(Оборудование) Тогда
		
		Сообщить("Не указано оборудование.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(Приоритет) Тогда
		
		Сообщить("Не указан приоритет заявки.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		
		Сообщить("Не указан ответственный.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	
	
	
	Если Работы.Количество() = 0 Тогда
		
		Сообщить("В заявке не указано ни одной работы.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	
	Для Каждого СтрокаРаботы Из Работы Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРаботы.ВидРаботы) Тогда
			
			Сообщить("В одной из строк не указан вид работы.");
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		
		Если СтрокаРаботы.Количество <= 0 Тогда
			
			Сообщить("Количество работ должно быть больше нуля.");
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		
		Если СтрокаРаботы.Цена < 0 Тогда
			
			Сообщить("Цена не может быть отрицательной.");
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;   
	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусЗаявки.Новая;
	КонецЕсли;
	
КонецПроцедуры